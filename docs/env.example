# Server-only MongoDB connection string. Required by GET/POST /api/recipes.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/recetas-del-corazon?retryWrites=true&w=majority

# Server-only shared token required for recipe creation and upload signing in production.
# Generate a long random value and share it with trusted family members only.
FAMILY_ACCESS_TOKEN=replace-with-a-long-random-token

# Server-only AWS credentials. Use a least-privilege IAM identity scoped to PutObject
# on the recipes/* prefix of the bucket. Required by POST /api/s3/upload.
AWS_ACCESS_KEY_ID=replace-with-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-secret-access-key
AWS_S3_REGION=us-east-1
AWS_S3_BUCKET_NAME=replace-with-bucket-name

# Browser-visible bucket coordinates used to construct uploaded image URLs.
# These are identifiers, not secrets, and must match the server-side bucket/region.
NEXT_PUBLIC_AWS_S3_REGION=us-east-1
NEXT_PUBLIC_AWS_S3_BUCKET_NAME=replace-with-bucket-name
